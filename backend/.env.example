DATABASE_URL="mysql://root:root@localhost:3307/car_management"
PORT=3000

# Login credentials. Generate the hash with: npm run hash-password -w backend
AUTH_USERNAME="admin"
AUTH_PASSWORD_HASH=""

# Secret used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Set to false only when serving over plain http (e.g. testing the production build locally)
COOKIE_SECURE=true
